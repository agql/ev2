  <button class="burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav">☰</button>
  <nav id="nav" class="nav">
    <a href="/" class="<%= activo === 'inicio' ? 'activo' : '' %>">Inicio</a>
    <a href="/galeria" class="<%= activo === 'galeria' ? 'activo' : '' %>">Galería</a>
    <a href="/subir" class="<%= activo === 'subir' ? 'activo' : '' %>">Subir imagen</a>
    <a href="/categorias" class="<%= activo === 'categorias' ? 'activo' : '' %>">Categorías</a>
    <a href="/contacto" class="<%= activo === 'contacto' ? 'activo' : '' %>">Contacto</a>
  </nav>
</header>
<% } %>
